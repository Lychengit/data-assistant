<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.djzy.assistant</groupId>
    <artifactId>doctor-data-assistant</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>data-gateway</artifactId>
  <name>data-gateway</name>
  <description>data-gateway：G1 验签与身份解析、G3 单点权限判定、G2 转发、G4 保护限额、G5 记账（§18.4.2 / §19.7 / §20.1）</description>
  <dependencies>
    <dependency>
      <groupId>com.djzy.assistant</groupId>
      <artifactId>common-platform</artifactId>
    </dependency>
    <dependency>
      <groupId>com.djzy.assistant</groupId>
      <artifactId>common-persistence</artifactId>
    </dependency>
    <dependency>
      <groupId>com.djzy.assistant</groupId>
      <artifactId>common-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <!-- 权限审计用 AOP 切面承载（与 interface-doctor 一样的做法）。 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-aop</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
