<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.djzy.assistant</groupId>
    <artifactId>common</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>common-persistence</artifactId>
  <name>common-persistence</name>
  <description>PG / Redis 落地的端口实现：权限读取、审计直写、接口注册表、用户状态、nonce 一次性消费</description>
  <dependencies>
    <dependency>
      <groupId>com.djzy.assistant</groupId>
      <artifactId>common-platform</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.data</groupId>
      <artifactId>spring-data-redis</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>test</scope>
    </dependency>    <!-- 真实 Redis 的集成测试要自己建连接工厂（Stream 语义只有真 Redis 跑得出来，见 RedisStreamEventQueueTest）；
         生产运行的连接池由服务侧的 spring-boot-starter-data-redis 提供，这里只给测试用。 -->
    <dependency>
      <groupId>io.lettuce</groupId>
      <artifactId>lettuce-core</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- 生产运行期 JDBC 驱动（服务以 jdbc:postgresql:// 连接 PG，§20.8）；测试用 H2 不受影响。 -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
  </dependencies>
</project>
