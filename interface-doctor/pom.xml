<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.djzy.assistant</groupId>
    <artifactId>doctor-data-assistant</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>interface-doctor</artifactId>
  <name>interface-doctor</name>
  <description>医生域接口服务：I1 验签、I2 使用网关下发身份与范围、I3 参数校验、I4 节点 F 行/列过滤（§18.4.5 / §19.7）</description>
  <dependencies>
    <dependency>
      <groupId>com.djzy.assistant</groupId>
      <artifactId>common-platform</artifactId>
    </dependency>
    <dependency>
      <groupId>com.djzy.assistant</groupId>
      <artifactId>common-web</artifactId>
    </dependency>
    <dependency>
      <groupId>com.djzy.assistant</groupId>
      <artifactId>common-persistence</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <!-- 数据访问审计走切面：新增接口零审计代码（§18.4.5 I6）。 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-aop</artifactId>
    </dependency>
    <!-- I3 用 DTO + Bean Validation，不再手写参数白名单。 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <!-- 多副本部署时 nonce 一次性校验走 Redis（§20.1.4-3）；单实例可用 memory 退化。 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
